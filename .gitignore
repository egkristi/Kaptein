# Rust build artifacts
/target/
**/*.rs.bk

# Cargo.lock is committed (do NOT ignore it): Kaptein is a binary application,
# so the lockfile gives reproducible, signed, auditable builds.

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Core dumps (from crashed processes, not part of the source tree)
core
core.*

# Local env / secrets
.env
.env.*
!.env.example
*.kubeconfig
